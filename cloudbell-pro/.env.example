# بيانات التطبيق
APP_NAME=CloudBell Pro
ENVIRONMENT=production
SECRET_KEY=change-me-with-openssl
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:8088

# قاعدة البيانات
POSTGRES_DB=cloudbell
POSTGRES_USER=cloudbell
POSTGRES_PASSWORD=change-me-with-openssl
DATABASE_URL=postgresql+psycopg2://cloudbell:change-me-with-openssl@postgres:5432/cloudbell

# Redis و Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
ENABLE_BEAT=false
CLEANUP_RETENTION_DAYS=30

# التخزين والتنزيلات
DATA_DIR=/data
MAX_DOWNLOAD_BYTES=5368709120
DOWNLOAD_USER_AGENT=CloudBellPro/1.0
DOWNLOAD_TIMEOUT_SECONDS=20
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
DOWNLOAD_MAX_REDIRECTS=5
DOWNLOAD_ALLOW_HTTP=false

# التهيئة الأولى للمسؤول
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
