# CloudBell Pro
APP_NAME=CloudBell Pro
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:8088

POSTGRES_DB=cloudbell
POSTGRES_USER=cloudbell
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg2://cloudbell:CHANGE_ME_TO_A_RANDOM_DATABASE_PASSWORD@postgres:5432/cloudbell

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
ENABLE_BEAT=false
CLEANUP_RETENTION_DAYS=30

DATA_DIR=/data
MAX_DOWNLOAD_BYTES=5368709120
MAX_ACTIVE_TRANSFERS_PER_USER=3
DOWNLOAD_USER_AGENT=CloudBellPro/1.0
DOWNLOAD_TIMEOUT_SECONDS=20
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
DOWNLOAD_MAX_REDIRECTS=5
DOWNLOAD_ALLOW_HTTP=false

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_RANDOM_BOOTSTRAP_PASSWORD
