APP_NAME=Network Home
VERSION=2.0
NODE_ENV=development
# Use production only when the site is served over HTTPS.
PORT=3000

POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://network_home:CHANGE_ME_TO_A_RANDOM_DATABASE_PASSWORD@postgres:5432/network_home

SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
CORS_ORIGIN=http://localhost:8080
PANTHER_URL=http://127.0.0.1:8787

# Optional PostgreSQL TLS for external databases.
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
